# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info
FRONTEND_URL=http://localhost:5173

# API Keys (Get these from platform developer portals)
# Instagram
INSTAGRAM_API_KEY=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok
TIKTOK_API_KEY=

# YouTube
YOUTUBE_API_KEY=

# Twitter/X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Facebook
FACEBOOK_API_KEY=
FACEBOOK_APP_ID=

# Snapchat
SNAPCHAT_API_KEY=

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_IP_PER_MINUTE=30

# Cache Settings
CACHE_TTL_SECONDS=900
PLATFORM_STATUS_CACHE_TTL=3600

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
