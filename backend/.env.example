# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
RUST_LOG=info

# ── yt-dlp binary ─────────────────────────────────────────────────────────────
# Auto-detects venv at ~/.local/share/vidclaw/venv (run scripts/setup_venv.sh)
# Override if needed:
# YTDLP_PATH=/custom/path/yt-dlp
# YTDLP_VENV=/custom/venv/dir

# Residential proxy for Instagram/Facebook on VPS/Render (not needed on home IP)
# YTDLP_PROXY=http://user:pass@proxy.webshare.io:80

# ── Instagram ─────────────────────────────────────────────────────────────────
# 1. Log into instagram.com in Chromium/Brave
# 2. DevTools (F12) → Application → Cookies → instagram.com
# 3. Copy the "sessionid" value and paste below
INSTAGRAM_SESSION_ID=

# ── Facebook ──────────────────────────────────────────────────────────────────
# 1. Log into facebook.com in Chromium/Brave
# 2. DevTools (F12) → Application → Cookies → facebook.com
# 3. Copy c_user, xs, fr values and format as: key=value;key=value
FACEBOOK_SESSION_COOKIES=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_IP_PER_MINUTE=30

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=900
PLATFORM_STATUS_CACHE_TTL=3600
